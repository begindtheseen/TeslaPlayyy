# YouTube Data API v3 key (metadata/search only). https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_key_here

# Optional: JSON catalog of media you are licensed to stream, e.g. config/media-catalog.json
# [{"id":"my-video","title":"My video","source":"https://cdn.example.com/my-video.mp4","license":"Own upload"}]
MEDIA_CATALOG_FILE=
# Hosts allowed for remote catalog sources (comma-separated, *.example.com allowed)
MEDIA_ALLOWED_HOSTS=
# Map YouTube video ids to licensed catalog assets: videoId=assetId,videoId2=assetId2
YOUTUBE_AUTHORIZED_MAP=

# Tuning (defaults shown)
# SESSION_TTL_SECONDS=60
# MEDIA_MAX_STREAMS=8
# MEDIA_STARTUP_TIMEOUT_MS=20000
# MEDIA_STALL_TIMEOUT_MS=30000
# MEDIA_MAX_STREAM_SECONDS=14400
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# TRUST_PROXY=1   # set behind a reverse proxy so rate limits use X-Forwarded-For

# ---- YouTube playback (public videos only; see docs/RESILIENCE.md) ----
# yt-dlp binary and extractor client fallback groups ('|' separated)
# YTDLP_PATH=yt-dlp
# YTDLP_CLIENTS=android_vr,web_safari|tv,ios|mweb
# YTDLP_TIMEOUT_MS=45000
# YTDLP_EXTRA_ARGS=["--extractor-args","youtubepot-bgutilhttp:base_url=http://127.0.0.1:4416"]
# YTDLP_UPDATE_ON_START=1          # Docker: pip-upgrade yt-dlp at container start
# EXTRACT_CACHE_SECONDS=300
# Outbound egress for yt-dlp AND media (googlevideo URLs are IP-locked to the extracting egress)
# PROXY_URL=socks5://user:pass@proxy.example:1080
# PROXY_URLS=http://u:p@p1.example:8080,http://u:p@p2.example:8080
# EGRESS_SOURCE_ADDRESSES=2a01:4f8:c0c:1234::10,2a01:4f8:c0c:1234::11
# EGRESS_IPV6_PREFIX=2a01:4f8:c0c:1234::/64   # needs AnyIP routing, see docs/RESILIENCE.md
# EGRESS_COOLDOWN_SECONDS=600
# EGRESS_HOOK_MODULE=./rotator.mjs            # exports pick(ctx) / onBlocked(ctx)
# EGRESS_ROTATE_COMMAND=smart-ipv6-rotator run --ipv6range=2a01:4f8:c0c:1234::/64
# Media relay
# CDN_CHUNK_BYTES=10485760
# STREAM_MAX_RELAYS=64
# STREAM_REQUIRE_SESSION=1          # 0 allows session-less /api/stream and /api/muxed (debugging only)
